<head>
    <style>
      .table-card {
        border-radius: 10px;
        background-color: #96c1cc;
        padding: 1rem;
        margin: 0 0 1rem 0;
      }

      .query-card {
        border-radius: 10px;
        background-color: #89b1bc;
        padding: 1rem;
        margin: 0 0 1rem 0;
      }

      .analysis-card {
        border-radius: 5px;
        padding: 0.5rem;
        background-color: #dcdcdc;
      }

      .copy-button {
        margin: 0 0 1rem 0;

      }
    </style>
</head>
<body>

<div>
    <a href="/10/nopurge">try with 10</a><br>
    <a href="/100/nopurge">try with 100</a><br>
    <a href="/1000/nopurge">try with 1000</a><br>
    <a href="/10000/nopurge">try with 10000</a><br>
    <a href="/100000/nopurge">try with 100000</a>
</div>


<h1>Comparison for {{ quantity }}</h1>

{# does not work. need to investigate how to do normally #}
{# <button onclick="copyJson()" class="copy-button">copy in json</button> #}


<div>
    {{ error }}
</div>

{% for a in analysis %}
    <div class="table-card">
        <b>{{ a.class }}</b>

        {% for q in a.queries %}
            <div class="query-card">
{#                <div><b>{{ q.method }}</b></div>#}
                <div>{{ q.sql[0:50] }} ...</div>
{#                {% ifq.sql|length > 30 %}#}
{#                {% endif %}#}
                <div class="analysis-card">
                    {% for analysisLine in q.analysis %}
                        <div>{{ analysisLine }}</div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endfor %}
<br>
<script>
  function copyJson() {
    let rawJson = '{{ analysisJson }}';

    navigator.clipboard.writeText(rawJson)
  }
</script>
</body>
